{
  "realm": "integra-esavi",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      { "name": "admin",    "description": "Administrador del sistema" },
      { "name": "analitic", "description": "Usuario analítico" },
      { "name": "arcsa",    "description": "Usuario ARCSA" },
      { "name": "dhis",     "description": "Usuario DHIS2" },
      { "name": "paho",     "description": "Usuario PAHO" }
    ]
  },
  "clients": [
    {
      "clientId": "integra-esavi-client",
      "name": "Integra ESAVI Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5173",
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3838",
        "http://localhost:*"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "+##https://localhost##https://localhost/*",
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "dash-integra-esavi-client",
      "name": "Integra ESAVI Dashboard",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "CAMBIAR_POR_SECRET_REAL",
      "redirectUris": [
        "https://localhost/oauth2/callback",
        "https://dashboard.dominio.org/oauth2/callback"
      ],
      "webOrigins": [
        "https://localhost",
        "https://dashboard.dominio.org"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "https://dashboard.dominio.org"
      },
      "protocolMappers": [
        {
          "name": "audience-dash-integra-esavi",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dash-integra-esavi-client",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin-user",
      "email": "admin-user@esavi.gob.ec",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Admin2025*", "temporary": false }],
      "realmRoles": ["admin"]
    },
    {
      "username": "analitic-user",
      "email": "analitic-user@esavi.gob.ec",
      "firstName": "Analitic",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Analitic2025*", "temporary": false }],
      "realmRoles": ["analitic"]
    },
    {
      "username": "arcsa-user",
      "email": "arcsa-user@esavi.gob.ec",
      "firstName": "Arcsa",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Arcsa2025*", "temporary": false }],
      "realmRoles": ["arcsa"]
    },
    {
      "username": "dhis2-user",
      "email": "dhis2-user@esavi.gob.ec",
      "firstName": "DHIS2",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Dhis2025*", "temporary": false }],
      "realmRoles": ["dhis"]
    },
    {
      "username": "paho-user",
      "email": "paho-user@esavi.gob.ec",
      "firstName": "PAHO",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Paho2025*", "temporary": false }],
      "realmRoles": ["paho"]
    }
  ]
}
