            "htmlCode": "<style type=\"text/css\">.loader {\n        position: fixed;\n        left: 0px;\n        top: 0px;\n        right: 0;\n        bottom: 0;\n        width: 100%;\n        height: 100%;\n        z-index: 9999;\n        /*background: url('pageLoader2.gif') 50% 50% no-repeat rgb(249,249,249);*/\n        background: rgb(249, 249, 249);\n        opacity: .8;\n        justify-content: center;\n        align-items: center;\n        display: flex;\n    }\n</style>\n<div class=\"loader\" style=\"font-size: 18px; font-weight: bold;\">Cargando...</div>\n\n<p><button class=\"btn btn-primary w-100\" id=\"btnBuscar\" onclick=\"imprimir()\"><svg class=\"bi bi-file-pdf\" fill=\"currentColor\" height=\"16\" viewbox=\"0 0 16 16\" width=\"16\" xmlns=\"http://www.w3.org/2000/svg\"> <path d=\"M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2H4zm0 1h8a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z\"> </path> <path d=\"M4.603 12.087a.81.81 0 0 1-.438-.42c-.195-.388-.13-.776.08-1.102.198-.307.526-.568.897-.787a7.68 7.68 0 0 1 1.482-.645 19.701 19.701 0 0 0 1.062-2.227 7.269 7.269 0 0 1-.43-1.295c-.086-.4-.119-.796-.046-1.136.075-.354.274-.672.65-.823.192-.077.4-.12.602-.077a.7.7 0 0 1 .477.365c.088.164.12.356.127.538.007.187-.012.395-.047.614-.084.51-.27 1.134-.52 1.794a10.954 10.954 0 0 0 .98 1.686 5.753 5.753 0 0 1 1.334.05c.364.065.734.195.96.465.12.144.193.32.2.518.007.192-.047.382-.138.563a1.04 1.04 0 0 1-.354.416.856.856 0 0 1-.51.138c-.331-.014-.654-.196-.933-.417a5.716 5.716 0 0 1-.911-.95 11.642 11.642 0 0 0-1.997.406 11.311 11.311 0 0 1-1.021 1.51c-.29.35-.608.655-.926.787a.793.793 0 0 1-.58.029zm1.379-1.901c-.166.076-.32.156-.459.238-.328.194-.541.383-.647.547-.094.145-.096.25-.04.361.01.022.02.036.026.044a.27.27 0 0 0 .035-.012c.137-.056.355-.235.635-.572a8.18 8.18 0 0 0 .45-.606zm1.64-1.33a12.647 12.647 0 0 1 1.01-.193 11.666 11.666 0 0 1-.51-.858 20.741 20.741 0 0 1-.5 1.05zm2.446.45c.15.162.296.3.435.41.24.19.407.253.498.256a.107.107 0 0 0 .07-.015.307.307 0 0 0 .094-.125.436.436 0 0 0 .059-.2.095.095 0 0 0-.026-.063c-.052-.062-.2-.152-.518-.209a3.881 3.881 0 0 0-.612-.053zM8.078 5.8a6.7 6.7 0 0 0 .2-.828c.031-.188.043-.343.038-.465a.613.613 0 0 0-.032-.198.517.517 0 0 0-.145.04c-.087.035-.158.106-.196.283-.04.192-.03.469.046.822.024.111.054.227.09.346z\"> </path> </svg> Clic para ver el formulario en PDF</button></p>\n\n<p style=\"display: none;\"><input id=\"ZEHbCzIS3cQ-fKZ98LmJyLq-val\" name=\"entryfield\" title=\"undefined\" value=\"[ undefined ]\"/></p>\n<script type=\"text/javascript\">\n    $(\".loader\").fadeOut(\"slow\");\n    /**\n     * Función para obtener el reporte PDF de EVADIE\n     */\n    async function imprimir() {\n        $(\".loader\").fadeIn(\"slow\");\n\n        // obtener los datos para la conexión al API que están como constantes en el sistema DHIS2\n        const datosAPI = await getDataAPI();\n        if (typeof datosAPI.url_api === 'undefined' || typeof datosAPI.pass_api === 'undefined') {\n            $(\".loader\").fadeOut(\"slow\");\n            alert(\"No se encuentra configurado los parámetros de conexión a la API.\");\n            return false;\n        }\n\n        // autenticar a la API\n        let conexion = '';\n        try {\n            conexion = await apiConnect();\n        } catch (error) {\n            console.log(\"ERROR: \", error);\n            $(\".loader\").fadeOut(\"slow\");\n            alert(\"No se puede conectar.\");\n        }\n\n        let datos = '';\n        if (conexion) {\n            // una vez autenticado obtener los datos del reporte\n            try {\n                datos = await getReport(datosAPI['url_api']);\n                $(\".loader\").fadeOut(\"slow\");\n            } catch (error) {\n                console.log(\"ERROR: \", error);\n                $(\".loader\").fadeOut(\"slow\");\n            }\n        }\n\n        // Función para obtener los datos de conexión a la API que están como constantes en el sistema DHIS2\n        async function getDataAPI() {\n            const arrayDatosAPI = [];\n            // obtener datos para la conección al API\n            return new Promise((resolve, reject) => {\n                $.get(DHIS2URL + \"/29/constants.json?fields=code,displayName,id,displayDescription&paging=false\", function (data, status) {\n                    let datos = data.constants\n                    if (datos.length > 0) {\n                        const url1 = datos.find(url => url.code === 'API_INTEGRACION_BASE');\n                        const pass1 = datos.find(pass => pass.code === 'API_PASSWORD');\n                        if (url1 !== undefined) {\n                            arrayDatosAPI['url_api'] = url1.displayDescription;\n                        }\n                        if (pass1 !== undefined) {\n                            arrayDatosAPI['pass_api'] = pass1.displayDescription;\n                        }\n                        arrayDatosAPI['usr_api'] = '';\n                    }\n                    resolve(arrayDatosAPI);\n                });\n            })\n        }\n\n        // Función para autenticar a la API\n        async function apiConnect() {\n            return new Promise((resolve, reject) => {\n                $.post(datosAPI['url_api'] + '/v1/auth', { \"user\": datosAPI['usr_api'], \"passwd\": datosAPI['pass_api'] })\n                    .done(function (data) {\n                        localStorage.setItem('mspToken', data.accessToken);\n                        resolve(data);\n                    })\n                    .fail(function () {\n                        reject('No se ha podido autenticar');\n                    });\n            })\n        }\n\n        // Obtener el reporte PDF\n        function getReport(ur_base) {\n            // llamar al API para obtener el reporte de ESAVI\n            const enrollmentId = $('input[id=\"ZEHbCzIS3cQ-fKZ98LmJyLq-val\"]').val();\n            const tei = getParam('tei');\n            const ou = getParam('ou');\n            const uri = `${ur_base}/v1/dhis2/reports/evadie/${tei}/pdf/${enrollmentId}/ou/${ou}`;\n\n            $.ajax({\n                url: uri,\n                cache: false,\n                method: 'GET',\n                headers: {\n                    \"Content-Type\": \"application/json\",\n                    \"Authorization\": \"Bearer \" + localStorage.getItem('mspToken')\n                },\n                xhrFields: {\n                    responseType: 'blob' //Most important : configure the response type as a blob\n                },\n                success: function (blobFile) {\n                    const url = window.URL.createObjectURL(blobFile);\n                    window.open(url, \"_blank\");\n                    $(\".loader\").fadeOut(\"slow\");\n                },\n                error: function (e) {\n                    console.log(\"DOWNLOAD ERROR :\", e);\n                    alert(\"Error al obtener la ficha PDF. Consulte con el administrador del sistema.\");\n                    $(\"body\").removeClass(\"loading\");\n                }\n            });\n        }\n    }\n\n    /**\n     * Función para buscar el valores del parámetro dentro de la url del dhis2\n     */\n    function getParam(param) {\n        let url1 = window.location.href;\n        const url = new URL(url1.replace('#', ''));\n        const urlParams = new URLSearchParams(url.search);\n        return urlParams.get(param);\n    }\n</script>",
