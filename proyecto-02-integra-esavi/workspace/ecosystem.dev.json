{
  "apps": [
    {
      "name": "api-integra-esavi-dev",
      "cwd": "./api-integra-esavi",
      "script": "node_modules/.bin/nest",
      "args": "start --watch",
      "interpreter": "node",
      "instances": 1,
      "exec_mode": "fork",
      "watch": false,
      "autorestart": true,
      "max_memory_restart": "512M",
      "env": {
        "NODE_ENV": "des"
      },
      "error_file": "./logs/error.dev.log",
      "out_file": "./logs/out.dev.log",
      "merge_logs": true,
      "time": true
    },
    {
      "name": "app-integra-esavi-dev",
      "cwd": "./app-integra-esavi",
      "script": "node_modules/.bin/vite",
      "args": ["--host", "0.0.0.0", "--port", "5173"],
      "interpreter": "node",
      "instances": 1,
      "exec_mode": "fork",
      "watch": false,
      "autorestart": true,
      "max_memory_restart": "256M",
      "env": {
        "NODE_ENV": "development"
      },
      "error_file": "./logs/error.dev.log",
      "out_file": "./logs/out.dev.log",
      "merge_logs": true,
      "time": true
    }
  ]
}
