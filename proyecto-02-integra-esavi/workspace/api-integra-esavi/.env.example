##[DEV|PROD|TEST]
ENV='DEV'
NODE_ENV='des'
PORT_DEFAULT=8081
NAME_PROYECT='integra'
DETAIL_PROYECT='MICROSERVICIOS INTEGRA ESAVI'
VERSION=1.0

# CORS: origins permitidas separadas por coma. Vacío = permite todas (solo dev).
# Ejemplo producción: CORS_ORIGINS=https://esaviecu.kuyacode.com
CORS_ORIGINS=
    
# MEDDRA
# Credenciales (MED_GRANT_TYPE, MED_CLIENT_ID, MED_USER_NAME, MED_PASSWORD, MED_SCOPE)
# migradas a TC_PARAMETRO (módulo MEDDRA). Ver ParametroService.getValor().
MED_URL_TOKEN='https://mid.meddra.org/connect/token'
MED_URL_API='https://mapisbx.meddra.org/api/search'

## WHODRUG DB
WHD_TRANSFORM_KEY='-----valor-----'
WHD_TRANSFORM_IV='-----valor-----'

## PARAMETRO — llave maestra única de cifrado simétrico (AES-256-GCM) para TC_PARAMETRO.VALOR
## Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROD_ENCRYPTION_KEY='-----valor-----'

## WHODRUG API
# URL y credenciales (WHD_API_URL, WHD_UMC_LICENSE_KEY, WHD_UMC_CLIENT_KEY)
# migradas a TC_PARAMETRO (módulo WHODRUG). Ver ParametroService.getValor().

