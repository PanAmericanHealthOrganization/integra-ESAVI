# ------------------------------------------------------------------------------
# Variables de entorno — dash-integra-esavi
# Copia este archivo a .env y completa los valores reales
# NUNCA subir .env al repositorio
# ------------------------------------------------------------------------------

# ── Datamart DuckDB (generado por api-integra-esavi) ───────────────────────────
# Archivo que el dashboard lee al arrancar (reemplaza datos_procesados.rds y
# dosis_admin.rds).
#
# La API lo escribe directamente en ./datos, que es de donde el dashboard lo lee, así
# que /app/datos/esavi.duckdb es el mismo archivo por el montaje de ese directorio.
#
# Fuera de contenedor no hace falta definir nada: el default de global.R ya es
# `datos/esavi.duckdb` relativo a la carpeta del dashboard.
DUCKDB_PATH=/app/datos/esavi.duckdb

# ── Base de datos PostgreSQL (servicio externo) ────────────────────────────────
# Nota: el dashboard ya NO consulta Postgres para los datos (usa el DuckDB).
# Estas variables quedan solo por compatibilidad histórica del pipeline retirado.
DB_HOST=host.docker.internal   # dev: host.docker.internal | prod: IP o hostname del servidor
DB_PORT=5432
DB_NAME=dhi_esavi
DB_USER=dhis
DB_PASS=

# ── Keycloak (mismo servidor en dev y prod) ────────────────────────────────────
VITE_KEYCLOAK_URL=#######
VITE_KEYCLOAK_REALM=integra-esavi
VITE_KEYCLOAK_CLIENT_ID=integra-esavi-client
KC_REQUIRED_ROLE=analitic   # rol requerido para entrar al dashboard (global.R), default: analitic
OAUTH2_CLIENT_SECRET=        # Keycloak → Clients → dash-integra-esavi-client → Credentials → Secret

# ── oauth2-proxy ──────────────────────────────────────────────────────────────
APP_URL=http://localhost:8090   # dev: localhost:8090 | prod: <tu-dominio-dashboard>

# Generar con: openssl rand -base64 32
OAUTH2_COOKIE_SECRET=

# ── Integra-ESAVI App (enlace del menú "Ir a Integra App") ────────────────────
INTEGRA_APP_URL=http://localhost:8080   # dev: localhost:8080 | prod: integra-esavi.ejemplo.com (ajustar al dominio real)
