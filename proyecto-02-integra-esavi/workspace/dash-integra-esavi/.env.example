# ---------------------------------------------------------------------------- -
# Archivo de ejemplo de variables de entorno
# Copia este archivo a .env y configura tus valores reales
# IMPORTANTE: NO subas el archivo .env a git
# ---------------------------------------------------------------------------- -

# Tokens de autenticación válidos (separados por comas)
# Genera tokens seguros usando: openssl rand -hex 32
DASHBOARD_AUTH_TOKENS=token_ejemplo_1,token_ejemplo_2,token_ejemplo_3

# Dominios permitidos para embedding (opcional)
# Si no se especifica, no se validará el origen
ALLOWED_DOMAINS=https://tu-dominio.com,https://app.tu-dominio.com

# Puerto del servidor (opcional)
SHINY_PORT=3838

# Host del servidor (opcional)
SHINY_HOST=0.0.0.0

# Configuración de logs (opcional)
LOG_ACCESS_ATTEMPTS=true
LOG_FILE_PATH=./logs/access.log
