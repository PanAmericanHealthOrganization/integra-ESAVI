# ------------------------------------------------------------------------------
# Variables de entorno — dash-integra-esavi
# Copia este archivo a .env y completa los valores reales
# NUNCA subir .env al repositorio
# ------------------------------------------------------------------------------

# ── Datamart DuckDB (generado por api-integra-esavi) ───────────────────────────
# Archivo que el dashboard lee al arrancar (reemplaza datos_procesados.rds y
# dosis_admin.rds). Debe estar en el volumen compartido con el API.
DUCKDB_PATH=/app/datos/esavi.duckdb

# ── Base de datos PostgreSQL (servicio externo) ────────────────────────────────
# Nota: el dashboard ya NO consulta Postgres para los datos (usa el DuckDB).
# Estas variables quedan solo por compatibilidad histórica del pipeline retirado.
DB_HOST=host.docker.internal   # dev: host.docker.internal | prod: IP o hostname del servidor
DB_PORT=5432
DB_NAME=dhi_esavi
DB_USER=dhis
DB_PASS=

# ── Keycloak (mismo servidor en dev y prod) ────────────────────────────────────
VITE_KEYCLOAK_URL=https://auth-kk.kuyacode.com
VITE_KEYCLOAK_REALM=integra-esavi
VITE_KEYCLOAK_CLIENT_ID=integra-esavi-client
KC_CLIENT_SECRET=        # Keycloak → Clients → dash-integra-esavi-client → Credentials → Secret

# ── oauth2-proxy ──────────────────────────────────────────────────────────────
# dev:  APP_URL=http://localhost:8090
# prod: APP_URL=https://dash-esaviecu.kuyacode.com
APP_URL=http://localhost:8090

# Generar con: openssl rand -base64 32
OAUTH2_COOKIE_SECRET=

# ── Integra-ESAVI App (enlace del menú "Ir a Integra App") ────────────────────
# dev:  INTEGRA_APP_URL=http://localhost:8080
# prod: INTEGRA_APP_URL=https://integra-esavi.ejemplo.com
INTEGRA_APP_URL=http://localhost:8080

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_ACCESS_ATTEMPTS=true
LOG_FILE_PATH=./logs/access.log
